@model ClinicBookingg.Models.Doctor

@{
    ViewData["Title"] = "Delete Doctor Confirmation";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card border-danger shadow-sm">
        <div class="card-header bg-danger text-white">
            <h4 class="mb-0">Delete Confirmation</h4>
        </div>
        <div class="card-body">
            <h5>Are you sure you want to delete this doctor?</h5>
            <dl class="row mt-3">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Specialty</dt>
                <dd class="col-sm-8">@Model.Specialty</dd>

                <dt class="col-sm-4">Experience</dt>
                <dd class="col-sm-8">@Model.YearsOfExperience years</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </form>
        </div>
    </div>
</div>